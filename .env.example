# Copy to .env.local and fill in. Never commit real values.
# Nothing here is read yet — these are wired up in phases 02 and 03.

# Neon PostgreSQL (phase 02)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js (phase 03) — generate with `npx auth secret`
AUTH_SECRET=""

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
