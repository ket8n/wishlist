# Copy to .env and fill in (read by both Next.js and the Prisma CLI).
# Never commit real values.

# Neon PostgreSQL — pooled connection string from the Neon console.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js (phase 03) — generate with `npx auth secret`
AUTH_SECRET=""

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub OAuth
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
